<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Lab3_Task1_2_MauiApp.MainPage">

    <ScrollView>
        <VerticalStackLayout
            Spacing="25"
            Padding="30,0"
            VerticalOptions="Center">

            <Label 
                Text="Введення числа"
                SemanticProperties.HeadingLevel="Level1"
                FontSize="32"
                HorizontalOptions="Center" />

            <Entry 
                x:Name="NumberEntry"
                Placeholder="Введіть ціле число"
                Keyboard="Numeric"
                HorizontalOptions="Center"
                WidthRequest="250"/>

            <Button
                x:Name="SubmitButton"
                Text="Підтвердити"
                SemanticProperties.Hint="Натисніть, щоб побачити введене число"
                Clicked="OnSubmitClicked"
                HorizontalOptions="Center"
                WidthRequest="200" />

            <Label 
                x:Name="ResultLabel"
                Text=""
                FontSize="18"
                TextColor="Blue"
                HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
